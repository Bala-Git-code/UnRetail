# Next.js Client Public Environment Variables
NEXT_PUBLIC_API_URL="http://localhost:5001/api/v1"

# Google OAuth Client ID for One-Tap and Pop-up Authentication
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"

# Razorpay Checkout Public Key ID (optional, fetched from server create-order)
# NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"

# Cloudinary Public Cloud Name (optional, signatures created on backend)
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
