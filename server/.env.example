# UnRetail Express API Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration (PostgreSQL Prisma connection URL)
DATABASE_URL=""

# Authentication & JWT Security
JWT_SECRET="your_production_secure_jwt_random_secret_string"
GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"
ADMIN_EMAIL="admin@unretail.in"
ADMIN_PASSWORD="your_secure_admin_password"

# Razorpay Payment Gateway (Indian Rupee Escrow)
RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpayKeySecretHere"
RAZORPAY_WEBHOOK_SECRET="YourRazorpayWebhookSecretHere"

# Cloudinary Media Storage (Catalog Images & KYC Documents)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Meilisearch Fast Catalog Indexing & Multi-Filter Engine
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_ADMIN_KEY="masterKey"

# CORS Configuration
CLIENT_URL="http://localhost:3000"
